<settings>
    <setting propertyKey="@Properties.CustomFtp" title="FTP (Watts)">
        <settingConfig type="numeric" min="50" max="600" errorMessage="Enter valid watts" />
    </setting>

    <setting propertyKey="@Properties.UseCustomPowerZones" title="Use Manual Power Zones">
        <settingConfig type="boolean" />
    </setting>
    <setting propertyKey="@Properties.PowerZone1Max" title="Power Zone 1 Upper (W)">
        <settingConfig type="numeric" min="0" max="1000" errorMessage="Enter valid watts" />
    </setting>
    <setting propertyKey="@Properties.PowerZone2Max" title="Power Zone 2 Upper (W)">
        <settingConfig type="numeric" min="0" max="1000" errorMessage="Enter valid watts" />
    </setting>
    <setting propertyKey="@Properties.PowerZone3Max" title="Power Zone 3 Upper (W)">
        <settingConfig type="numeric" min="0" max="1000" errorMessage="Enter valid watts" />
